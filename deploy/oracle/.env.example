# Use your own DNS name or PUBLIC_IP.sslip.io, for example 203.0.113.10.sslip.io.
DOMAIN=203.0.113.10.sslip.io
ACME_EMAIL=you@example.com

# Generate unique values with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-value
JWT_SECRET=replace-with-a-different-random-hex-value

# Conservative public-demo limits for the free VM.
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=1
EXECUTION_PIDS_LIMIT=32
EXECUTION_OUTPUT_LIMIT_BYTES=262144
CRDT_FLUSH_INTERVAL_SECONDS=30
CRDT_MAX_UPDATE_BYTES=5242880
CRDT_CHECKPOINT_TTL_SECONDS=604800
