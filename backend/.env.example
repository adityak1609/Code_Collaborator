# Database
DATABASE_URL=postgresql+psycopg://concord:concord@localhost:5432/concord
SYNC_DATABASE_URL=postgresql+psycopg://concord:concord@localhost:5432/concord

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Execution
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MEMORY_LIMIT=256m
EXECUTION_CPU_LIMIT=1
EXECUTION_PIDS_LIMIT=64

# CRDT Persistence
CRDT_FLUSH_INTERVAL_SECONDS=30
