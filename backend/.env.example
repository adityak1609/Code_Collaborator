# Database
DATABASE_URL=postgresql+psycopg://concord:concord@localhost:5432/concord
SYNC_DATABASE_URL=postgresql+psycopg://concord:concord@localhost:5432/concord

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# JSON array of browser origins allowed by CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Execution
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MEMORY_LIMIT=256m
EXECUTION_CPU_LIMIT=1
EXECUTION_PIDS_LIMIT=64

# CRDT Persistence
CRDT_FLUSH_INTERVAL_SECONDS=30
CRDT_MAX_UPDATE_BYTES=5242880
CRDT_CHECKPOINT_TTL_SECONDS=604800
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MEMORY_LIMIT=256m
EXECUTION_CPU_LIMIT=1
EXECUTION_PIDS_LIMIT=64
EXECUTION_OUTPUT_LIMIT_BYTES=1048576
EXECUTION_POLL_INTERVAL_SECONDS=0.25
